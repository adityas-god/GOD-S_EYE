# ==============================================================================
# Insight Hub Environment Configuration
# ==============================================================================

# Host Port Exposure (Single exposed port for frontend container reverse proxy)
# Configured to 8082 to prevent conflicts with 5000 (Auto_BOT), 8080 (InfluxQL), and 8081 (GOD-S_EYE)
HOST_PORT=8081

# Backend Internal Configuration
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:8081

# MongoDB Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ef4bjjj.mongodb.net/operations_db?retryWrites=true&w=majority
MONGODB_DB_NAME=operations_db

# Salesforce Credentials & Integration
SF_LOGIN_URL=https://login.salesforce.com
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_API_VERSION=v59.0
WEBHOOK_SECRET=

# Opsgenie API Integration
OPSGENIE_API_KEY=

# Google Gemini AI Integration for pulse AI (Gemini 2.5 Flash / pulse x_7)
GEMINI_API_KEY=

# Red Zone Reliability Google Sheet URL
RED_ZONE_SHEET_URL=https://docs.google.com/spreadsheets/d/1dKhduZF_lYKWMrQ2bYBvufUxZt6oeQibNtx78P_id9M/edit?gid=1207923458#gid=1207923458

# Optional custom secret password for pulse AI session reset
PULSE_AI_SECRET=

# Atlassian (Confluence & Jira) API Configuration
ATLASSIAN_CLOUD_ID=917cbbff-c0f2-4cf8-ae9d-279bd24a0a5a
ATLASSIAN_EMAIL=aditya.s.ctr@greyorange.com
