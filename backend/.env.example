# Server Configuration
PORT=5050
NODE_ENV=development

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ef4bjjj.mongodb.net/operations_db?retryWrites=true&w=majority
MONGODB_DB_NAME=operations_db

# Salesforce API Integration (Optional / Mock Mode by default)
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SALESFORCE_CLIENT_ID=your_client_id_here
SALESFORCE_CLIENT_SECRET=your_client_secret_here
SALESFORCE_USERNAME=integrations@enterprise.internal
SALESFORCE_PASSWORD=your_password_plus_token
SALESFORCE_MOCK_ENABLED=true
 
# Grafana Integration
GRAFANA_BASE_URL=https://cloudwatch.greymatter.greyorange.com
GRAFANA_API_TOKEN=glsa_your_token_here
# Optional: session cookie for corporate SSO / Grafana if proxying authenticated panels
GRAFANA_COOKIE=grafana_session=your_cookie_here
